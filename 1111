-- تحكم السلايدر للسرعات
local draggingFly = false
FlySlider.MouseButton1Down:Connect(function() draggingFly = true end)

local draggingPath = false
PathSlider.MouseButton1Down:Connect(function() draggingPath = true end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFly = false
        draggingPath = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if draggingFly then
            local relativeX = math.clamp(input.Position.X - FlySlider.AbsolutePosition.X, 0, FlySlider.AbsoluteSize.X)
            local scale = relativeX / FlySlider.AbsoluteSize.X
            FlySpeed = math.floor(scale * 200)
            if FlySpeed < 10 then FlySpeed = 10 end
            FlyFill.Size = UDim2.new(scale, 0, 1, 0)
            FlyLabel.Text = "سرعة الطيران: " .. FlySpeed
        elseif draggingPath then
            local relativeX = math.clamp(input.Position.X - PathSlider.AbsolutePosition.X, 0, PathSlider.AbsoluteSize.X)
            local scale = relativeX / PathSlider.AbsoluteSize.X
            PathSpeed = math.floor(scale * 150)
            if PathSpeed < 5 then PathSpeed = 5 end
            PathFill.Size = UDim2.new(scale, 0, 1, 0)
            PathLabel.Text = "سرعة المسار: " .. PathSpeed
        end
    end
end)

-- ترقيم السطور المضافة
local function refreshIndices()
    for index, entry in ipairs(Waypoints) do
        entry.Name = "إحداثية رقم " .. index
        if entry.Tag then entry.Tag.Text = entry.Name end
        if entry.NameLabel then entry.NameLabel.Text = entry.Name end
        if entry.Frame then entry.Frame.LayoutOrder = index end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, #Waypoints * 38)
end

-- إضافة إحداثية
local function addWaypoint(position)
    WaypointCount = WaypointCount + 1
    local id = #Waypoints + 1
    local name = "إحداثية رقم " .. id
    
    local Billboard = Instance.new("BillboardGui")
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 120, 0, 25)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    
    local Tag = Instance.new("TextLabel")
    Tag.Size = UDim2.new(1, 0, 1, 0)
    Tag.BackgroundTransparency = 1
    Tag.Text = name
    Tag.TextColor3 = Color3.fromRGB(255, 215, 0)
    Tag.TextStrokeTransparency = 0
    Tag.TextSize = 12
    Tag.Font = Enum.Font.SourceSansBold
    Tag.Parent = Billboard
    
    local Part = Instance.new("Part")
    Part.Size = Vector3.new(0.5, 0.5, 0.5)
    Part.Position = position
    Part.Anchored = true
    Part.CanCollide = false
    Part.Color = Color3.fromRGB(255, 215, 0)
    Part.Parent = workspace
    Billboard.Parent = Part

    local ItemFrame = Instance.new("Frame")
    ItemFrame.Size = UDim2.new(0.96, 0, 0, 34)
    ItemFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    ItemFrame.LayoutOrder = id
    ItemFrame.Parent = ScrollList
    
    local ItemCorner = Instance.new("UICorner")
    ItemCorner.CornerRadius = UDim.new(0, 5)
    ItemCorner.Parent = ItemFrame
    
    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(0.5, -5, 1, 0)
    NameLabel.Position = UDim2.new(0, 8, 0, 0)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Text = name
    NameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left
    NameLabel.TextSize = 11
    NameLabel.Font = Enum.Font.SourceSansBold
    NameLabel.Parent = ItemFrame
    
    local TeleportBtn = Instance.new("TextButton")
    TeleportBtn.Size = UDim2.new(0.22, 0, 0.7, 0)
    TeleportBtn.Position = UDim2.new(0.52, 0, 0.15, 0)
    TeleportBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
    TeleportBtn.Text = "انتقال"
    TeleportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TeleportBtn.Font = Enum.Font.SourceSansBold
    TeleportBtn.TextSize = 10
    TeleportBtn.Parent = ItemFrame
    
    local TPCorner = Instance.new("UICorner")
    TPCorner.CornerRadius = UDim.new(0, 4)
    TPCorner.Parent = TeleportBtn

    local DeleteBtn = Instance.new("TextButton")
    DeleteBtn.Size = UDim2.new(0.22, 0, 0.7, 0)
    DeleteBtn.Position = UDim2.new(0.76, 0, 0.15, 0)
    DeleteBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    DeleteBtn.Text = "حذف"
    DeleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    DeleteBtn.Font = Enum.Font.SourceSansBold
    DeleteBtn.TextSize = 10
    DeleteBtn.Parent = ItemFrame
    
    local DelCorner = Instance.new("UICorner")
    DelCorner.CornerRadius = UDim.new(0, 4)
    DelCorner.Parent = DeleteBtn

    local entry = { Name = name, Pos = position, Part = Part, Frame = ItemFrame, Tag = Tag, NameLabel = NameLabel }
    table.insert(Waypoints, entry)

    TeleportBtn.MouseButton1Click:Connect(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(position + Vector3.new(0, 2.5, 0))
        end
    end)

    DeleteBtn.MouseButton1Click:Connect(function()
        Part:Destroy()
        ItemFrame:Destroy()
        for i, v in ipairs(Waypoints) do
            if v == entry then
                table.remove(Waypoints, i)
                break
            end
        end
        refreshIndices()
    end)

    refreshIndices()
end

